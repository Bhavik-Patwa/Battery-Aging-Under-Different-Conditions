      "sensitivity_cohort_eligible": true,
      "incident_contexts": [
        {
          "cell_identity": "Stage_1/TP_z17_03",
          "incident_sequence": 13
        }
      ],
      "description": "The outcome follows cycling exposure associated with an incorrect maximum state of charge and requires review before primary analytical use."
    },
    {
      "reason_code": "FAILED_SOC_RESET_DOWNSTREAM_OUTCOME",
      "originating_reason_code": "FAILED_STATE_OF_CHARGE_RESET",
      "source": "Project data-quality policy based on a documented Scientific Data incident",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z20_03/TP_z20_03_(?:1[7-9]|2\\d|3[01])_(?:CU|exCU|AT_T(?:10|23|45))\\.csv$",
      "disposition": "manual_review",
      "outcome_scope": "subsequent_reference_performance_test_outcomes",
