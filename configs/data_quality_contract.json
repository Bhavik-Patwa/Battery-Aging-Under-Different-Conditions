      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z07_03/TP_z07_03_(?:1[7-9]|2[0-5])_(?:CU|exCU|AT_T(?:10|23|45))\\.csv$",
      "disposition": "manual_review",
      "outcome_scope": "subsequent_reference_performance_test_outcomes",
      "affected_exposure_interval": "From the cell-holder connection failure during sequence 16 through the end of the recorded study. No unaffected recovery point is documented.",
      "primary_cohort_eligible": false,
      "sensitivity_cohort_eligible": true,
      "incident_contexts": [
        {
          "cell_identity": "Stage_2/TP_z07_03",
          "incident_sequence": 16
        }
      ],
      "description": "The outcome follows an undefined cycling load caused by cell-holder connection failures and requires review before primary analytical use."
