      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z25_01/TP_z25_01_(?:01_ET_T23|(?:0[3-9]|[12]\\d|3[01])_(?:CU|exCU|AT_T(?:10|23|45)))\\.csv$",
      "disposition": "manual_review",
      "outcome_scope": "subsequent_reference_performance_test_outcomes",
      "affected_exposure_interval": "From the undefined initial-test load through the end of the recorded study. The publication does not document a point at which its possible downstream effect can be ruled out.",
      "primary_cohort_eligible": false,
      "sensitivity_cohort_eligible": true,
      "incident_contexts": [
        {
          "cell_identity": "Stage_1/TP_z25_01",
          "incident_sequence": 1
        }
      ],
      "description": "The outcome follows an undefined load during the initial reference test and requires review before primary analytical use."
    },
    {
      "reason_code": "UNDEFINED_CYCLING_LOAD_DOWNSTREAM_OUTCOME",
