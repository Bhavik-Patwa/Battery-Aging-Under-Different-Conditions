    "cycle_minimum_state_of_charge_fraction": 0.2,
    "cycle_maximum_state_of_charge_fraction": 0.8
  },
  "measurement_contract": {
    "columns": [
      "run_time",
      "c_vol",
      "c_cur",
      "c_surf_temp",
      "amb_temp",
      "step_type"
    ],
    "optional_leading_source_row_index_column": "",
    "optional_trailing_elapsed_seconds_column": "time_to_sec",
    "elapsed_seconds_tolerance_seconds": 0.001,
    "elapsed_seconds_floating_point_margin_seconds": 0.000000001,
    "numeric_run_time_disposition": "manual_review",
    "minimum_voltage_volts": 0.0,
    "maximum_voltage_volts": 5.0,
    "minimum_current_amperes": -30.0,
    "maximum_current_amperes": 30.0,
    "minimum_surface_temperature_celsius": -40.0,
    "maximum_surface_temperature_celsius": 100.0,
    "cycling_direction_tolerance_amperes": 0.05
  },
  "feature_contract": {
    "capacity": {
      "primary_definition": "Mean of positive-current step-21 capacity and absolute negative-current step-22 capacity.",
      "unit": "Ah",
      "status": "approved"
    },
    "fully_equivalent_cycles": {
      "primary_definition": "Integral of absolute measured current for step-41 and step-42 samples exceeding 0.05 A, divided by twice the 4.9 Ah reference capacity.",
      "sensitivity_definition": "Signed current integrated according to recorded step-41 and step-42 labels for samples exceeding 0.05 A.",
      "reference_capacity_ah": 4.9,
      "status": "approved"
    },
    "dc_internal_resistance": {
      "primary_definition": "Uncorrected voltage change divided by discharge current after ten seconds of the step-5032 pulse.",
      "sensitivity_definition": "OCV-corrected ten-second resistance.",
      "ocv_normalization_requirement": "Capacity-based normalization is required before OCV-corrected resistance is approved for analytical use.",
      "unit": "ohm",
      "status": "primary_approved_sensitivity_provisional"
    },
    "calendar_time": {
      "primary_available_definition": "Gross days between reference-test start dates.",
      "future_definition": "Net aging exposure excluding reference-test duration and documented pauses.",
      "status": "gross_approved_net_pending"
    },
    "delivery_state_characteristics": {
      "initial_cell_mass": {
        "source_column": "m_0",
        "unit": "gram",
        "status": "descriptive_baseline_characteristic"
      },
      "initial_1khz_resistance": {
        "source_column": "R_1khz_0",
        "source_unit_label": "ohm",
        "observed_source_value_minimum": 11.84,
        "observed_source_value_maximum": 14.42,
        "unit_status": "unresolved_source_label_conflicts_with_observed_scale_and_cell_specification",
        "conversion_status": "not_applied",
        "status": "descriptive_only_until_unit_resolved"
      },
      "initial_voltage": {
        "source_column": "U_0",
        "unit": "volt",
        "status": "descriptive_baseline_characteristic"
      }
    },
    "source_header_artifacts": {
      "volt_meter_leading_whitespace": {
        "source_field_name": " volt_meter",
        "normalized_field_name": "volt_meter",
        "rule": "exact_documented_alias_only",
        "unsupported_header_whitespace_disposition": "rejected"
      }
    }
  },
  "downstream_incident_rules": [
