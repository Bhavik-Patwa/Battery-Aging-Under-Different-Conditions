      "target_scope": "measurement",
      "target_pattern": "^Stage_1/(?:TP_z24_01/TP_z24_01_(?:0[3-9]|[12]\\d|3[01])_(?:CU|exCU|AT_T(?:10|23|45))|TP_z25_01/TP_z25_01_(?:0[5-9]|[12]\\d|3[01])_(?:CU|exCU|AT_T(?:10|23|45)))\\.csv$",
      "disposition": "manual_review",
      "outcome_scope": "subsequent_reference_performance_test_outcomes",
      "affected_exposure_interval": "From the documented undefined cycling load through the end of the recorded study. The publication does not establish that later degradation outcomes are unaffected.",
      "primary_cohort_eligible": false,
      "sensitivity_cohort_eligible": true,
      "incident_contexts": [
        {
          "cell_identity": "Stage_1/TP_z24_01",
          "incident_sequence": 2
        },
        {
          "cell_identity": "Stage_1/TP_z25_01",
          "incident_sequence": 4
        }
