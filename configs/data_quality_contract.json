  "incident_rules": [
    {
      "reason_code": "CAPACITY_CYCLE_REPLACED_CHARGE_OCV_POSSIBLY_CORRUPTED",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_k(?:08|09|10|11)_(?:01|04)/TP_k(?:08|09|10|11)_(?:01|04)_01_ET_T23\\.csv$",
      "disposition": "manual_review",
      "description": "The failed discharge-capacity cycle was replaced, but the charge OCV may be corrupted."
    },
    {
      "reason_code": "MANUAL_STATE_OF_CHARGE_ADJUSTMENT",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_k11_02/TP_k11_02_03_exCU\\.csv$",
      "disposition": "include_with_warning",
      "description": "The cell was manually charged from 80% to 100% state of charge."
    },
    {
      "reason_code": "UNDEFINED_LOAD_DURING_INITIAL_TEST",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z25_01/TP_z25_01_01_ET_T45\\.csv$",
      "disposition": "exclude",
      "description": "The cell was incorrectly placed in its holder and experienced an undefined load."
    },
    {
      "reason_code": "UNDEFINED_LOAD_DURING_CYCLING",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/(?:TP_z24_01/TP_z24_01_02_ZYK|TP_z25_01/TP_z25_01_04_ZYK)\\.csv$",
      "disposition": "exclude",
      "description": "The cell was incorrectly placed in its holder and experienced an undefined cycling load."
    },
    {
      "reason_code": "CYCLING_MEASUREMENT_MISSING",
      "source": "Scientific Data publication",
      "target_scope": "archive",
      "target_pattern": "^Stage_1/TP_z19_01\\.zip$",
      "disposition": "manual_review",
      "incident_details": {
        "cycling_performed": true,
        "missing_sequence_numbers": [
          4
        ]
      },
      "description": "Cycling was performed correctly, but the sequence-04 cycling measurement is missing."
    },
    {
      "reason_code": "LAB_BLACKOUT_WITH_STATE_OF_CHARGE_RESET",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z(?:0[4-9]|1[0-5])_\\d{2}/TP_z(?:0[4-9]|1[0-5])_\\d{2}_04_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "description": "Cycling continued after a laboratory blackout and state-of-charge reset."
    },
    {
      "reason_code": "CAPACITY_FILE_CONCATENATED_AFTER_TESTER_MALFUNCTION",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z01_03/TP_z01_03_11_CU\\.csv$",
      "disposition": "manual_review",
      "description": "Files were concatenated after a tester malfunction during the capacity measurement."
    },
    {
      "reason_code": "INCORRECT_MAXIMUM_STATE_OF_CHARGE",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z17_03/TP_z17_03_(?:13_exCU|17_CU)\\.csv$",
      "disposition": "exclude",
      "description": "The measurement followed an incorrect maximum state of charge."
    },
    {
      "reason_code": "LAB_BLACKOUT_DURING_CYCLING",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z(?:1[6-9]|2[0-5])_\\d{2}/TP_z(?:1[6-9]|2[0-5])_\\d{2}_16_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "description": "Cycling continued after a laboratory blackout and state-of-charge reset."
    },
    {
      "reason_code": "FAILED_STATE_OF_CHARGE_RESET",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z20_03/TP_z20_03_16_ZYK\\.csv$",
      "disposition": "exclude",
      "description": "Cycling continued at an incorrect maximum state of charge after a failed reset."
    },
    {
      "reason_code": "MANUAL_CHARGE_DURING_EXTENDED_CHECK_UP",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z17_02/TP_z17_02_19_exCU\\.csv$",
      "disposition": "include_with_warning",
      "description": "The cell was manually charged to the assigned maximum state of charge."
    },
    {
      "reason_code": "PARTIALLY_MISSING_CYCLING_MEASUREMENT",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z(?:21_01|24_01|25_02)/TP_z(?:21_01|24_01|25_02)_22_ZYK\\.csv$",
      "disposition": "manual_review",
      "description": "Cycling was performed correctly, but part of the measurement is missing."
    },
    {
      "reason_code": "FIFTEEN_DAY_CYCLING_PAUSE",
      "source": "Scientific Data publication",
      "target_scope": "archive",
      "target_pattern": "^Stage_2/TP_z(?:1[3-7]|19|20|22|23|24)_\\d{2}\\.zip$",
      "expected_absent_measurement_pattern": "^TP_z(?:1[3-7]|19|20|22|23|24)_\\d{2}/TP_z(?:1[3-7]|19|20|22|23|24)_\\d{2}_14_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "incident_details": {
        "cycling_performed": false,
        "missing_sequence_numbers": [
          14
        ]
      },
      "description": "Cycling was paused for fifteen days during climate-chamber downtime. The corresponding sequence-14 cycling measurement is expected to be absent."
    },
    {
      "reason_code": "CELL_HOLDER_CONNECTION_FAILURE",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z07_03/TP_z07_03_16_ZYK\\.csv$",
      "disposition": "exclude",
      "description": "Cell-holder connection failures produced an undefined cycling load."
    },
    {
      "reason_code": "FOUR_DAY_CYCLING_PAUSE",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z(?:12|18|21)_\\d{2}/TP_z(?:12|18|21)_\\d{2}_22_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "description": "Cycling was paused for four days before restarting with a tempering pause."
    },
    {
      "reason_code": "TWENTY_DAY_CYCLING_PAUSE",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z(?:1[3-7]|19|20|22|23|24)_\\d{2}/TP_z(?:1[3-7]|19|20|22|23|24)_\\d{2}_22_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "description": "Cycling was paused for twenty days before restarting with a tempering pause."
    },
    {
      "reason_code": "EXTENDED_MISSING_CYCLING_MEASUREMENT",
      "source": "Scientific Data publication",
      "target_scope": "archive",
      "target_pattern": "^Stage_2/TP_z(?:01|03)_\\d{2}\\.zip$",
      "disposition": "manual_review",
      "incident_details": {
        "cycling_performed": true,
        "missing_sequence_numbers": [
          24
        ]
      },
      "description": "Cycling was performed for thirty-three days without a recorded sequence-24 cycling measurement."
    },
    {
      "reason_code": "TWO_DAYS_OF_CYCLING_DATA_MISSING",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z(?:0[4-9]|10|11)_\\d{2}/TP_z(?:0[4-9]|10|11)_\\d{2}_24_ZYK\\.csv$",
      "disposition": "manual_review",
      "description": "Two days of cycling measurements are missing although cycling was performed."
    },
    {
      "reason_code": "FINAL_CAPACITY_TEST_INTERRUPTED",
      "source": "Scientific Data publication",
      "source_target_identity": "TP_z12_*_31_AT_T45",
      "target_scope": "measurement",
      "target_pattern": "^Stage_2/TP_z12_\\d{2}/TP_z12_\\d{2}_33_AT_T45\\.csv$",
      "disposition": "manual_review",
      "description": "The publication identifies the final 45°C capacity test as sequence 31. In the pinned dataset, sequence 31 is exCU and the final 45°C AT is sequence 33. The final test was interrupted during capacity discharge and continued after fifty-five minutes."
    },
    {
      "reason_code": "FINAL_REFERENCE_TEST_PRECEDING_STRESS",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_[12]/TP_[kz]\\d{2}_\\d{2}/TP_[kz]\\d{2}_\\d{2}_\\d{2}_AT_T23\\.csv$",
      "disposition": "include_with_warning",
      "description": "The final 23°C result may include stress from preceding final tests at 10°C and 45°C."
    },
    {
      "reason_code": "LOWER_VOLTAGE_BOUND_CORRECTED_DURING_CYCLING",
      "source": "Scientific Data publication",
      "target_scope": "measurement",
      "target_pattern": "^Stage_1/TP_z17_03/TP_z17_03_18_ZYK\\.csv$",
      "disposition": "include_with_warning",
      "description": "The lower voltage bound was corrected during cycling using the corresponding twin-cell settings after the preceding incorrect maximum state of charge."
    }
  ]
}