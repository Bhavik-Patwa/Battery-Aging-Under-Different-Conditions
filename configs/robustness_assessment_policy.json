  "assessment_domains": [
    {"assessment_identity": "stage_stratified_performance_comparison", "evidence_source": "validation_summary", "evidence_unit": "validation_summary_record", "evaluation_rule": "stage_separated_summaries_of_completed_validation", "interpretation": "Validation summaries are reported separately by dataset stage. No exchangeability across stages is asserted."},
    {"assessment_identity": "cross_stage_transportability", "evidence_source": "estimand_support", "evidence_unit": "cross_stage_estimand_comparison", "evaluation_rule": "cross_stage_comparison_presence", "interpretation": "Cross-stage comparison and transport are not authorized because stage and batch are aliased and exact treatment combinations do not overlap."},
    {"assessment_identity": "cohort_sensitivity_comparison", "evidence_source": "cohort_sensitivity", "evidence_unit": "cohort_comparison_record", "evaluation_rule": "exact_match_primary_sensitivity", "interpretation": "Primary and sensitivity cohort comparisons are reported as descriptive evidence only."},
    {"assessment_identity": "model_specification_comparison", "evidence_source": "model_family_comparisons_and_descriptive_specification_comparisons", "evidence_unit": "model_comparison_record", "evaluation_rule": "shared_candidate_pairwise_and_descriptive_template_pairwise", "interpretation": "Specification comparisons are reported as descriptive evidence. No registered stability criterion is applied."},
    {"assessment_identity": "prior_scale_sensitivity_comparison", "evidence_source": "prior_sensitivity", "evidence_unit": "prior_sensitivity_record", "evaluation_rule": "registered_multiplier_pairs", "interpretation": "Posterior changes across registered prior scales are reported without a post-hoc stability threshold."},
    {"assessment_identity": "cell_influence_assessment", "evidence_source": "influence_summary", "evidence_unit": "candidate_influence_record", "evaluation_rule": "per_candidate_deletion_refits", "interpretation": "Delete-one-cell refit outcomes are reported explicitly. Failed refits remain visible."},
    {"assessment_identity": "cross_framework_prediction_comparison", "evidence_source": "prediction_agreement", "evidence_unit": "candidate_family_prediction_comparison", "evaluation_rule": "exact_shared_inventory", "interpretation": "Cross-framework predictive agreement is reported descriptively. Partial inventories are reported as diagnostic-only."},
    {"assessment_identity": "cohort_inclusion_sensitivity", "evidence_source": "cohort_sensitivity", "evidence_unit": "cohort_comparison_record", "evaluation_rule": "exact_match_primary_sensitivity", "interpretation": "Primary-versus-sensitivity cohort comparison is a proxy for incident inclusion and does not isolate individual incident classes."},
    {"assessment_identity": "laboratory_and_equipment_separability", "evidence_source": "design_identifiability_and_estimand_identification", "evidence_unit": "structural_limitation_category", "evaluation_rule": "structural_limitation_presence", "interpretation": "Laboratory, equipment and condition effects remain inseparable where allocation is aliased. Source-record counts remain separate in the structural-limitations table."},
    {"assessment_identity": "alternative_outcome_definition", "evidence_source": "feature_contract", "evidence_unit": "feature_contract_limitation", "evaluation_rule": "unsupported_by_design", "interpretation": "Uncorrected resistance remains primary. OCV-corrected resistance is provisional and is not substituted as an alternative primary outcome."},
    {"assessment_identity": "net_calendar_exposure", "evidence_source": "estimand_support", "evidence_unit": "estimand_support_record", "evaluation_rule": "unavailable_by_design", "interpretation": "Gross whole-protocol elapsed time is available; net storage exposure remains unavailable."},
    {"assessment_identity": "batch_stability", "evidence_source": "analytical_scope", "evidence_unit": "analytical_scope_record", "evaluation_rule": "stage_batch_aliasing", "interpretation": "Battery-cell batch is structurally linked to dataset stage; independent batch sensitivity is unsupported."},
    {"assessment_identity": "prediction_interval_diagnostics", "evidence_source": "prediction_interval_diagnostics_and_predictive_sensitivity", "evidence_unit": "interval_diagnostic_group", "evaluation_rule": "registered_held_out_interval_groups", "interpretation": "Coverage and width are reported from primary held-out predictions and registered predictive-sensitivity variants. These are empirical diagnostics, not distribution-free coverage guarantees."},
    {"assessment_identity": "horizon_evaluation_sensitivity", "evidence_source": "horizon_evaluation_sensitivity_and_predictive_sensitivity", "evidence_unit": "candidate_horizon_sensitivity_record", "evaluation_rule": "held_out_evaluation_windows_and_training_window_refits", "interpretation": "Evaluation-window rescoring and first-or-terminal training-observation exclusion refits are reported separately. Neither is extrapolated beyond authorized support."},
    {"assessment_identity": "incident_evaluation_sensitivity", "evidence_source": "incident_evaluation_sensitivity_and_predictive_sensitivity", "evidence_unit": "candidate_incident_sensitivity_record", "evaluation_rule": "held_out_incident_rescoring_and_reason_specific_training_exclusion_refits", "interpretation": "Evaluation-only incident exclusions and reason-specific training-exclusion refits are reported separately. They do not identify causal incident effects."},
    {"assessment_identity": "validation_partition_refit_sensitivity", "evidence_source": "predictive_sensitivity", "evidence_unit": "alternative_partition_variant", "evaluation_rule": "deterministic_condition_stratified_cell_grouped_refits", "interpretation": "Predictive stability is evaluated under two alternative deterministic condition-stratified cell-grouped partitions with nested selection confined to each training population."},
    {"assessment_identity": "held_out_feature_ablation", "evidence_source": "predictive_sensitivity", "evidence_unit": "predictor_ablation_variant", "evaluation_rule": "grouped_predictor_ablation_with_held_out_cell_evaluation", "interpretation": "Horizon, condition and interaction predictor groups are removed one at a time and evaluated on held-out cells. Results describe predictive dependence and are not causal."},
    {"assessment_identity": "expanded_hyperparameter_search", "evidence_source": "predictive_sensitivity", "evidence_unit": "expanded_configuration_variant", "evaluation_rule": "nested_selection_over_registered_expanded_configuration_inventory", "interpretation": "The expanded inventory retains every primary configuration and adds prespecified intermediate settings. It evaluates search sensitivity without claiming global hyperparameter optimality."},
    {"assessment_identity": "bayesian_model_form_sensitivity", "evidence_source": "registered_policy_restriction", "evidence_unit": "registered_assessment", "evaluation_rule": "not_assessed_without_registered_alternative_model_forms", "interpretation": "Prior-scale sensitivity does not establish robustness to alternative Bayesian trajectory or likelihood forms."},
    {"assessment_identity": "condition_calibration_coverage", "evidence_source": "condition_calibration", "evidence_unit": "benchmark_condition_record", "evaluation_rule": "unavailable_condition_inventory", "interpretation": "Conditions without held-out predictions remain explicit external-validity restrictions."},
    {"assessment_identity": "causal_ml_sensitivity", "evidence_source": "causal_identification", "evidence_unit": "registered_assessment", "evaluation_rule": "not_authorized_without_causal_identification", "interpretation": "Causal machine-learning sensitivity is not performed because causal identification is not established."}
  ],
  "external_validity_domains": [
    {"domain_identity": "represented_cells_and_conditions", "applicability_status": "supported_with_restrictions", "boundary": "Samsung INR21700-50E cells under observed condition-protocol combinations and authorized observation ranges."},
    {"domain_identity": "unobserved_operating_conditions", "applicability_status": "unsupported", "boundary": "No interpolation or extrapolation to unobserved joint operating-condition combinations."},
    {"domain_identity": "other_cell_chemistries", "applicability_status": "unsupported", "boundary": "No generalization to other cell chemistries."},
    {"domain_identity": "other_cell_formats", "applicability_status": "unsupported", "boundary": "No generalization to other cell formats."},
    {"domain_identity": "battery_packs", "applicability_status": "unsupported", "boundary": "Cell-level results do not establish pack-level behavior."},
    {"domain_identity": "unsupported_fast_charging", "applicability_status": "unsupported", "boundary": "No generalization to charging regimes absent from the observed design."},
    {"domain_identity": "cross_stage_effect_transport", "applicability_status": "not_authorized", "boundary": "Dataset stages remain separate because cross-stage exchangeability is not established."},
    {"domain_identity": "causal_treatment_effects", "applicability_status": "not_authorized", "boundary": "Observed design evidence does not establish causal identification."},
    {"domain_identity": "operating_policy_recommendations", "applicability_status": "not_authorized", "boundary": "Associational and predictive results do not authorize treatment or operating-policy recommendations."}
  ],
