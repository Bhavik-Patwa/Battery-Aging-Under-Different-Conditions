FROM python:3.11.18-slim-trixie@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

ARG SOURCE_REVISION="unavailable"
ARG SOURCE_URL="https://github.com/Bhavik-Patwa/Adaptive-Battery-Aging-Policy"
ARG EVIDENCE_POLICY_SHA256="unavailable"

RUN printf '%s' "$SOURCE_REVISION" \
        | grep --extended-regexp --quiet '^[0-9a-f]{40}$' \
    && printf '%s' "$EVIDENCE_POLICY_SHA256" \
        | grep --extended-regexp --quiet '^[0-9a-f]{64}$' \
    && test -n "$SOURCE_URL"

LABEL org.opencontainers.image.title="Battery Aging Evidence Explorer" \
    org.opencontainers.image.description="Read-only reporting interface for validated battery-aging evidence." \
    org.opencontainers.image.source="${SOURCE_URL}" \
    org.opencontainers.image.revision="${SOURCE_REVISION}" \
    org.opencontainers.image.version="${SOURCE_REVISION}" \
    org.opencontainers.image.vendor="Bhavik Patwa" \
    org.opencontainers.image.evidence-policy-sha256="${EVIDENCE_POLICY_SHA256}"

COPY --from=ghcr.io/astral-sh/uv:0.12.16@sha256:adc68cd785ca65ea25c0611043b0a00b4ea3a22e1b54102fc084406d888082ee /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/app \
    EVIDENCE_ARTIFACT_ROOT=/artifacts \
    EVIDENCE_DASHBOARD_POLICY=/app/configs/evidence_dashboard_policy.json

ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN uv sync \
        --frozen \
        --only-group dashboard \
        --no-install-project \
    && rm --recursive --force \
        /root/.cache/uv \
        /usr/local/lib/python3.11/site-packages/pip* \
        /usr/local/lib/python3.11/site-packages/setuptools* \
        /usr/local/lib/python3.11/site-packages/wheel* \
        /usr/local/lib/python3.11/site-packages/jaraco* \
        /usr/local/lib/python3.11/site-packages/_jaraco* \
    && rm --force \
        /usr/local/bin/pip \
        /usr/local/bin/pip3 \
        /usr/local/bin/pip3.11 \
        /usr/local/bin/wheel \
        /usr/local/bin/easy_install* \
        /bin/uv \
        /bin/uvx

COPY dashboard ./dashboard
COPY configs/evidence_dashboard_policy.json ./configs/evidence_dashboard_policy.json
COPY .streamlit ./.streamlit

RUN groupadd \
        --system \
        application \
    && useradd \
        --system \
        --gid application \
        --create-home \
        application \
    && chown \
        --recursive \
        application:application \
        /app

USER application

EXPOSE 8501

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=15s \
    --retries=3 \
    CMD ["python", "-c", "import urllib.request; response = urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3); raise SystemExit(0 if response.status == 200 else 1)"]

ENTRYPOINT ["sh", "-c", "python -m dashboard.healthcheck && exec streamlit run dashboard/app.py --server.address=0.0.0.0 --server.port=8501"]